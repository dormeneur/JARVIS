# === Vault ===
# Absolute path on YOUR machine where vault files are stored (bind-mounted into the containers).
# Mac/Linux example: /Users/<you>/JARVIS-vault   Windows example: C:/JARVIS-vault
JARVIS_HOST_PATH=/CHANGE/ME/TO/YOUR/VAULT/FOLDER
JARVIS_VAULT_PATH=/data/JARVIS
JARVIS_MAX_UPLOAD_MB=100
JARVIS_LOG_LEVEL=INFO

# === Auth ===
JARVIS_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256_BIT_STRING
JARVIS_JWT_EXPIRY_HOURS=720
JARVIS_MAX_DEVICES=5

# === Backups ===
# Host folder for automatic + on-demand vault zips. Keep it OUTSIDE the vault,
# ideally on a different disk. Defaults to ./backups next to docker-compose.yml.
# JARVIS_BACKUP_HOST_PATH=D:/JARVIS-backups
JARVIS_BACKUP_INTERVAL_HOURS=24
JARVIS_BACKUP_KEEP=10

# === Job search (optional, admin devices only) ===
# Runs the ai-job-search engine on your own Claude subscription. See
# DOCUMENTATION/OFFICIAL-DOCS/12-Job-Search-Integration.md and HOW_TO_RUN.md.
# Path to your PRIVATE ai-job-search clone on the host.
# JARVIS_JOBS_WORKSPACE=B:/DEV/ai-job-search
# Shared secret between jv-api and jv-jobs (any long random string).
JARVIS_JOBS_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
JARVIS_JOBS_MAX_PARALLEL=2
# The Claude token does NOT go here (every container reads .env). Put it in
# jobs.env next to this file:  CLAUDE_CODE_OAUTH_TOKEN=<from `claude setup-token`>

# === Sync ===
# Timestamp tolerance in seconds for conflict detection (default: 2)
# Files with timestamps within this window and different hashes are treated as conflicts
JARVIS_SYNC_TIMESTAMP_TOLERANCE_SECONDS=2

# === AI Integration ===
# Ollama runs on this machine (install it from ollama.com); the containers reach it here.
# (Using the optional Docker Ollama instead? Set http://ollama:11434 and start with --profile docker-ollama.)
JARVIS_OLLAMA_URL=http://host.docker.internal:11434

# ChromaDB vector database URL (internal Docker network)
JARVIS_VECTORDB_URL=http://chromadb:8000

# Brain service URL (internal Docker network)
JARVIS_BRAIN_URL=http://brain:8001

# Embedding model for vector generation
JARVIS_EMBEDDING_MODEL=nomic-embed-text

# LLM model for answer generation — must be tool-calling-capable for the agent chat to work
# (llama3 has no tool template and will narrate shell commands instead of calling tools).
# qwen3:4b fits small GPUs; qwen3:8b answers better with 6 GB or more.
JARVIS_LLM_MODEL=qwen3:4b

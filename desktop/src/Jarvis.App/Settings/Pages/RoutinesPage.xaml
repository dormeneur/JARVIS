<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.RoutinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Routines" />
      <TextBlock
          Margin="0,0,0,8"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="Background jobs on a schedule. They run while your PC is on and Jarvis is running (not while paused). You can also just ask: &quot;every weekday at 9, summarise the tech news&quot;."
          TextWrapping="Wrap" />
      <TextBlock
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="No routines yet."
          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Routines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RoutineRow">
            <Grid Margin="0,3" Padding="16,12" Background="{StaticResource Surface1Brush}" ColumnSpacing="12" CornerRadius="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Schedule}" />
                <TextBlock MaxLines="2" Text="{x:Bind Brief}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Status}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Click="OnRunNow" Content="Run now" Tag="{x:Bind Id}" />
                <Button Click="OnRemove" Content="Delete" Tag="{x:Bind Id}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource GroupTitle}" Text="New routine" />
      <TextBox Header="What should it do?" PlaceholderText="e.g. Summarise today's top tech news in five bullets" Text="{x:Bind ViewModel.NewBrief, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Header="When?" PlaceholderText="weekdays 09:00" Text="{x:Bind ViewModel.NewSchedule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddCommand}" Content="Add routine" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
      <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.ScheduleHint, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Voice" />
      <settings:SettingRow Description="How Jarvis sounds when it talks back." Header="Voice">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox MinWidth="220" ItemsSource="{x:Bind ViewModel.Voices}" SelectedItem="{x:Bind ViewModel.SelectedVoice, Mode=TwoWay}" />
          <Button Command="{x:Bind ViewModel.PreviewCommand}" Content="Preview" />
        </StackPanel>
      </settings:SettingRow>
      <settings:SettingRow Description="1.0 is normal." Header="Speaking speed">
        <Slider Width="220" Maximum="1.4" Minimum="0.7" StepFrequency="0.05" Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
      </settings:SettingRow>
      <settings:SettingRow Description="Seconds the written answer stays in the notch after Jarvis finishes speaking." Header="Keep answers on screen">
        <Slider Width="220" Maximum="20" Minimum="3" StepFrequency="1" Value="{x:Bind ViewModel.CaptionSeconds, Mode=TwoWay}" />
      </settings:SettingRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Agents" />
      <settings:SettingRow Description="Jobs do longer work: research, documents, plans. Opus is the most thorough; Sonnet is the balance." Header="Model for background jobs">
        <ComboBox MinWidth="140" ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.Model, Mode=TwoWay}" />
      </settings:SettingRow>
      <settings:SettingRow Description="When a job finishes, Jarvis reads the first sentence of its result aloud. Off: it only shows in the notch, with a chime." Header="Speak job results">
        <ToggleSwitch IsOn="{x:Bind ViewModel.SpeakResults, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="More jobs at once use more of your Claude plan." Header="Jobs at once">
        <Slider Width="200" Maximum="5" Minimum="1" SnapsTo="Ticks" StepFrequency="1" TickFrequency="1" Value="{x:Bind ViewModel.MaximumConcurrent, Mode=TwoWay}" />
      </settings:SettingRow>
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.RestartNeeded, Mode=OneWay}"
          Message="This change applies after Jarvis restarts."
          Severity="Informational">
        <InfoBar.ActionButton>
          <Button Command="{x:Bind ViewModel.RestartCommand}" Content="Restart Jarvis" />
        </InfoBar.ActionButton>
      </InfoBar>
      <settings:SettingRow Description="Every job keeps its brief, its results (in output) and notes here. Jobs can only read and write inside their own folder, and search the web." Header="Job folders">
        <Button Command="{x:Bind ViewModel.OpenJobsFolderCommand}" Content="Open" />
      </settings:SettingRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.AboutMePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title, and what this is -->
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Style="{StaticResource PageTitle}" Text="About me" />
        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.ReloadCommand}" ToolTipService.ToolTip="Reload from your vault">
        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE72C;" />
      </Button>
    </Grid>

    <!-- Tell Jarvis anything: the local brain files it in the right place -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox KeyDown="OnAnythingKeyDown" PlaceholderText="Tell Jarvis something about you… it files it in the right place" Text="{x:Bind ViewModel.Anything, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button Grid.Column="1" Command="{x:Bind ViewModel.AddAnywhereCommand}" Content="Add" Style="{StaticResource AccentButtonStyle}" />
    </Grid>

    <!-- Graph or list, search (both), a new topic, and the view -->
    <Grid Grid.Row="2" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ToggleButton x:Name="GraphMode" Click="OnGraphMode" Content="Graph" IsChecked="True" />
        <ToggleButton x:Name="ListMode" Click="OnListMode" Content="List" />
      </StackPanel>
      <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search what Jarvis knows…" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox x:Name="NewTopic" Grid.Column="2" KeyDown="OnNewTopicKeyDown" PlaceholderText="New topic or folder/topic" />
      <Button Grid.Column="3" Click="OnNewTopic" ToolTipService.ToolTip="Make a new topic (a file in your Profile folder)">
        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE8F4;" />
      </Button>
      <Button Grid.Column="4" Click="OnRecenter" ToolTipService.ToolTip="See the whole map">
        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE9A6;" />
      </Button>
      <Button Grid.Column="5" Click="OnOpenFolder" ToolTipService.ToolTip="Open your Profile folder in File Explorer">
        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xED25;" />
      </Button>
    </Grid>

    <!-- Graph: the map on the left, what you picked on the right -->
    <Grid x:Name="GraphPanel" Grid.Row="3" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="DetailColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Border x:Name="GraphHost" MinHeight="260" />
      <TextBlock
          Margin="10"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          FontSize="11"
          Foreground="{StaticResource TextTertiaryBrush}"
          IsHitTestVisible="False"
          Text="Drag to move · scroll to zoom · click a dot to open it" />
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Detail" Padding="12" Background="{StaticResource Surface1Brush}" CornerRadius="10" Spacing="8" />
      </ScrollViewer>
    </Grid>

    <!-- List: every fact, editable line by line -->
    <ScrollViewer x:Name="ListPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileGroup">
            <StackPanel Spacing="4">
              <TextBlock Style="{StaticResource GroupTitle}" Text="{x:Bind Title}" />
              <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{x:Bind Path}" />
              <ItemsControl ItemsSource="{x:Bind Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FactRow">
                    <Grid Margin="0,2" Padding="10,6" Background="{StaticResource Surface1Brush}" ColumnSpacing="6" CornerRadius="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox
                          Background="Transparent"
                          BorderThickness="0"
                          KeyDown="OnFactKeyDown"
                          LostFocus="OnFactLostFocus"
                          Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          TextWrapping="Wrap" />
                      <Button
                          Grid.Column="1"
                          Width="30"
                          Height="30"
                          Padding="0"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          BorderThickness="0"
                          Click="OnDelete"
                          ToolTipService.ToolTip="Delete this">
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Glyph="&#xE74D;" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox KeyDown="OnNewKeyDown" PlaceholderText="Add to this…" Text="{x:Bind NewFact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Click="OnAdd" Content="Add" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.ConnectorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Connectors" />
      <TextBlock
          Margin="0,0,0,8"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="Let background jobs use your services through their MCP servers (Linear, Notion, an internal tool…). Jobs only change things in a service when you ask them to. Keys and sign-ins are kept in Windows-protected storage, never in Jarvis's settings."
          TextWrapping="Wrap" />
      <TextBlock
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="No connectors yet."
          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Connectors}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectorRow">
            <Grid Margin="0,3" Padding="16,12" Background="{StaticResource Surface1Brush}" ColumnSpacing="12" CornerRadius="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Auth}" />
                <TextBlock FontSize="12" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Click="OnTest" Content="Test" Tag="{x:Bind Name}" />
                <Button Click="OnSignIn" Content="Sign in again" Tag="{x:Bind Name}" Visibility="{x:Bind CanSignIn}" />
                <Button Click="OnRemove" Content="Remove" Tag="{x:Bind Name}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource GroupTitle}" Text="Add a connector" />
      <TextBox Header="Name" PlaceholderText="linear" Text="{x:Bind ViewModel.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBox Header="Server URL" PlaceholderText="https://mcp.example.com/mcp" Text="{x:Bind ViewModel.NewUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox MinWidth="200" Header="Authentication" ItemsSource="{x:Bind ViewModel.AuthChoices}" SelectedItem="{x:Bind ViewModel.SelectedAuth, Mode=TwoWay}" />
      <PasswordBox Header="API key" Password="{x:Bind ViewModel.NewKey, Mode=TwoWay}" Visibility="{x:Bind ViewModel.NeedsKey, Mode=OneWay}" />
      <Button Margin="0,6,0,0" Command="{x:Bind ViewModel.AddCommand}" Content="Add connector" Style="{StaticResource AccentButtonStyle}" />
      <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.FormMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

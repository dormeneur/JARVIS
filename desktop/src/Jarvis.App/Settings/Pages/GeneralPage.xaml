<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="General" />
      <settings:SettingRow Description="Open Jarvis when you sign in, so it's always ready." Header="Start with Windows">
        <ToggleSwitch IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Soft chimes when the text box opens or sends, when a typed answer arrives, and when background jobs start and finish." Header="Play sounds">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Sounds, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="A quiet pen scratch while Jarvis draws on your screen." Header="Pen sound when drawing">
        <ToggleSwitch IsEnabled="{x:Bind ViewModel.Sounds, Mode=OneWay}" IsOn="{x:Bind ViewModel.DrawingSounds, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Closing this window keeps Jarvis running in the tray. To rest it for a while, use Pause in the tray menu. Quit closes it fully; open it again from the Start menu." Header="Quit Jarvis">
        <Button Command="{x:Bind ViewModel.QuitCommand}" Content="Quit" />
      </settings:SettingRow>
      <TextBlock Style="{StaticResource GroupTitle}" Text="Brain" />
      <settings:SettingRow Description="Sonnet balances speed and smarts. Opus is the most capable but slower; Haiku is the fastest." Header="Claude model">
        <ComboBox MinWidth="140" ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.BrainModel, Mode=TwoWay}" />
      </settings:SettingRow>
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.RestartNeeded, Mode=OneWay}"
          Message="This change applies after Jarvis restarts."
          Severity="Informational">
        <InfoBar.ActionButton>
          <Button Command="{x:Bind ViewModel.RestartCommand}" Content="Restart Jarvis" />
        </InfoBar.ActionButton>
      </InfoBar>
      <TextBlock Style="{StaticResource GroupTitle}" Text="Engines" />
      <settings:SettingRow Description="{x:Bind ViewModel.Engines}" Header="In use" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

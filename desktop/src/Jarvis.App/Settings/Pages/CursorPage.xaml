<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.CursorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Cursor" />
      <settings:SettingRow Description="The cursor's colour. Drawings and highlights use the same ink." Header="Colour">
        <ComboBox MinWidth="160" ItemsSource="{x:Bind ViewModel.Colors}" SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ColorChoice">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="{x:Bind Brush}" />
                <TextBlock Text="{x:Bind Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </settings:SettingRow>
      <settings:SettingRow Description="Off hides it and stops it following you." Header="Show the floating cursor">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Visible, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Shake the mouse to leave Jarvis where it is for a moment." Header="Shake to detach">
        <ToggleSwitch IsOn="{x:Bind ViewModel.ShakeToDetach, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="While you hold the talk keys, circle something with the mouse (or rest on it) and say &quot;what's this?&quot;. Jarvis knows which part you meant." Header="Highlighter">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Highlighter, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Games, videos and presentations: the cursor and the resting notch step aside. Anything you start still shows." Header="Hide when something is fullscreen">
        <ToggleSwitch IsOn="{x:Bind ViewModel.HideInFullscreen, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>

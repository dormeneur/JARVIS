<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Vault" />
      <TextBlock
          Margin="0,0,0,8"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="Connect Jarvis to your JARVIS vault, like your phone, so it can fill forms and answer questions from your notes and Profile. Those answers are made by the vault's own brain on this PC (Ollama); nothing from your vault is ever sent to Claude, and Secrets stay out of reach."
          TextWrapping="Wrap" />
      <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource GroupTitle}" Text="Connect this PC" />
      <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
        <Run Text="1. Make sure the JARVIS server is running (docker compose up -d in the JARVIS folder)." /><LineBreak />
        <Run Text="2. Get a one-time invite code: run  docker exec jv-api python -m app.invite  in a terminal. It lasts 10 minutes and works once." /><LineBreak />
        <Run Text="3. Paste it below and click Connect." />
      </TextBlock>
      <settings:SettingRow Description="{x:Bind ViewModel.Message, Mode=OneWay}" Header="Invite code">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="300" FontFamily="{StaticResource FontMono}" PlaceholderText="Paste the code" Text="{x:Bind ViewModel.InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button Command="{x:Bind ViewModel.ConnectCommand}" Content="Connect" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </settings:SettingRow>
      <settings:SettingRow Description="Jarvis forgets this PC's key. The server keeps the device until you revoke it on your phone." Header="Disconnect">
        <Button Command="{x:Bind ViewModel.DisconnectCommand}" Content="Disconnect" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Filling forms" />
      <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
        <Run Text="• With a form open in your browser (Google Forms and most others), say or type &quot;fill this form&quot;, pick Fill a form on the notch's home (rest the mouse on the notch), or use the tray menu. Needs the browser extension (Settings → Browser)." /><LineBreak />
        <Run Text="• The notch shows a card per question: copy it, pick another remembered answer, say it, or reload it. Questions your vault doesn't answer are marked. &quot;Why us?&quot; questions are drafted on this PC from your vault plus public facts about the organisation." /><LineBreak />
        <Run Text="• Fill it in for me types the answers into the page and checks each one took; it never submits. Answers you've used before come back instantly next time (Profile/form-memory.json)." /><LineBreak />
        <Run Text="• Swipe the panel (or click the folder icon) for its files: upload your latest resume, add context files for this form, and delete past forms. Answers you type can be saved to Profile/standard-answers.md; Jarvis asks before it writes." />
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>

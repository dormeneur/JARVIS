<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.MicrophonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Microphone" />
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.Blocked, Mode=OneWay}"
          Message="Windows privacy settings stop desktop apps, Jarvis included, from using the microphone. Turn on &quot;Let desktop apps access your microphone&quot;, then come back."
          Severity="Error"
          Title="Windows is blocking the microphone">
        <InfoBar.Content>
          <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" Content="Open Windows settings" Style="{StaticResource AccentButtonStyle}" />
            <Button Command="{x:Bind ViewModel.CheckAgainCommand}" Content="Check again" />
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
      <settings:SettingRow Description="Windows default follows whatever Windows sound settings use. If a chosen microphone is unplugged, Jarvis falls back to the default." Header="Microphone">
        <ComboBox Width="280" ItemsSource="{x:Bind ViewModel.Devices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" />
      </settings:SettingRow>
      <settings:SettingRow Description="{x:Bind ViewModel.Verdict, Mode=OneWay}" Header="Test your microphone">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ProgressBar Width="160" VerticalAlignment="Center" Maximum="1" Value="{x:Bind ViewModel.Level, Mode=OneWay}" />
          <Button Command="{x:Bind ViewModel.TestCommand}" Content="Test" />
          <Button Command="{x:Bind ViewModel.TestCancelCommand}" Content="Stop" />
        </StackPanel>
      </settings:SettingRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>

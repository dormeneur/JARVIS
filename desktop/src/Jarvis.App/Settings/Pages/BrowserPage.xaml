<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Browser" />
      <TextBlock
          Margin="0,0,0,8"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="Link Chrome, Brave, Edge or Arc so Jarvis can read the page you're on when you ask about it, including the parts scrolled off screen, and open links you approve. The extension talks only to Jarvis on this PC."
          TextWrapping="Wrap" />
      <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />

      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.HasWaiting, Mode=OneWay}"
          Message="A browser extension wants to link to Jarvis. Allow it only if you just installed Jarvis Browser Link yourself."
          Severity="Warning"
          Title="Allow this extension?">
        <InfoBar.ActionButton>
          <Button Command="{x:Bind ViewModel.ApproveCommand}" Content="Allow" />
        </InfoBar.ActionButton>
      </InfoBar>

      <settings:SettingRow Description="When you ask Jarvis something with your browser in front, it reads that tab's text and address for Claude. Each read is listed in Privacy &amp; memory → Screen history." Header="Read the page you're on">
        <ToggleSwitch IsOn="{x:Bind ViewModel.ReadPage, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Set it up (once)" />
      <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
        <Run Text="1. In your browser, open the extensions page (chrome://extensions, brave://extensions or edge://extensions) and turn on Developer mode." /><LineBreak />
        <Run Text="2. Click Load unpacked and choose the Jarvis extension folder (buttons below)." /><LineBreak />
        <Run Text="3. Come back here and click Allow when Jarvis asks." />
      </TextBlock>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{x:Bind ViewModel.OpenFolderCommand}" Content="Open the extension folder" />
        <Button Command="{x:Bind ViewModel.CopyFolderCommand}" Content="Copy its location" />
      </StackPanel>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Linked extensions" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Allowed}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid Margin="0,2" Padding="12,6" Background="{StaticResource Surface1Brush}" CornerRadius="6">
              <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" Text="{x:Bind}" />
              <Button HorizontalAlignment="Right" Click="OnForget" Content="Forget" Tag="{x:Bind}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

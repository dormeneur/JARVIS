<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.DictationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings"
    xmlns:vm="using:Jarvis.App.Settings.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Dictation" />
      <settings:SettingRow Description="A fast model fixes punctuation and removes filler words before typing (about 2 s). Off types exactly what was heard, faster." Header="Tidy up what I say">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Cleanup, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Auto-detect follows you across languages. Pin one for the most accurate results." Header="Language">
        <ComboBox MinWidth="160" ItemsSource="{x:Bind ViewModel.Languages}" SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
      </settings:SettingRow>
      <TextBlock Style="{StaticResource GroupTitle}" Text="Dictionary" />
      <settings:SettingRow Description="Names and terms Jarvis should spell your way. It also learns them when you correct a dictated word." Header="Your words">
        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" />
      </settings:SettingRow>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox PlaceholderText="Add a word, e.g. Priya" Text="{x:Bind ViewModel.NewWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Command="{x:Bind ViewModel.AddWordCommand}" Content="Add" />
      </Grid>
      <ItemsControl ItemsSource="{x:Bind ViewModel.Words}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid Margin="0,2" Padding="12,6" Background="{StaticResource Surface1Brush}" CornerRadius="6">
              <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
              <Button HorizontalAlignment="Right" Click="OnRemoveWord" Content="Remove" Tag="{x:Bind}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

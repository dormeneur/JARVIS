<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Privacy &amp; memory" />

      <TextBlock Style="{StaticResource GroupTitle}" Text="Your screen" />
      <settings:SettingRow Description="Jarvis never watches your screen. It takes one screenshot only when you ask it something (talk keys, typed question or clicking the cursor). Off: it answers from your words alone." Header="Let Jarvis see my screen when I ask">
        <ToggleSwitch IsOn="{x:Bind ViewModel.ScreenAccess, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="The notch says &quot;Looking at your screen&quot; at the moment a screenshot is taken." Header="Show me when it looks">
        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowWhenLooking, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Off (default): the cursor and notch are invisible to screen recordings, screen sharing and screenshots, Jarvis's own included. On: they show up, which helps when recording a demo. Applies after a restart." Header="Show Jarvis in screen recordings">
        <ToggleSwitch IsOn="{x:Bind ViewModel.ShowInRecordings, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Every screenshot Jarvis has taken, newest first. Kept only on this PC; what you said is never written here." Header="Screen history">
        <Button Command="{x:Bind ViewModel.ClearLooksCommand}" Content="Clear history" />
      </settings:SettingRow>
      <TextBlock Margin="4,2,0,2" FontWeight="SemiBold" Text="{x:Bind ViewModel.LastLook, Mode=OneWay}" TextWrapping="Wrap" />
      <ItemsControl MaxHeight="220" ItemsSource="{x:Bind ViewModel.Looks}">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Margin="4,1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Your mouse and keyboard" />
      <settings:SettingRow Description="Ask Jarvis to do something on screen (&quot;turn on dark mode&quot;) and it can click and type for you. Every single step asks first: the cursor shows where, the notch says exactly what, and nothing happens until you click Do it. Stop or Esc ends it. Needs screen access." Header="Let Jarvis use my mouse and keyboard">
        <ToggleSwitch IsEnabled="{x:Bind ViewModel.ScreenAccess, Mode=OneWay}" IsOn="{x:Bind ViewModel.LetJarvisDrive, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Every step: each click or keystroke waits for Do it. Once per task: you approve the task, then Jarvis works through it on its own (looking again as it goes) with a glowing border around the screen. Move the mouse or press any key to take back instantly." Header="Ask me">
        <ComboBox MinWidth="300" IsEnabled="{x:Bind ViewModel.LetJarvisDrive, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.DriveModes}" SelectedItem="{x:Bind ViewModel.DriveMode, Mode=TwoWay}" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Conversation memory" />
      <settings:SettingRow Description="How long Jarvis remembers what you talked about, so you can say &quot;and what about that one?&quot;. Shorter is more private. The recent exchanges shown above the text box (double-tap Ctrl) live in memory only and go when you press Forget or quit Jarvis." Header="Remember the conversation for">
        <ComboBox MinWidth="280" ItemsSource="{x:Bind ViewModel.ConversationChoices}" SelectedItem="{x:Bind ViewModel.Conversation, Mode=TwoWay}" />
      </settings:SettingRow>
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.RestartNeeded, Mode=OneWay}"
          Message="This change applies after Jarvis restarts."
          Severity="Informational">
        <InfoBar.ActionButton>
          <Button Command="{x:Bind ViewModel.RestartCommand}" Content="Restart Jarvis" />
        </InfoBar.ActionButton>
      </InfoBar>
      <settings:SettingRow Description="{x:Bind ViewModel.ForgetMessage, Mode=OneWay}" Header="Forget the conversation now">
        <Button Command="{x:Bind ViewModel.ForgetCommand}" Content="Forget" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Computer memory" />
      <settings:SettingRow Description="The speech and voice models take about 1 GB of RAM. Freeing them saves memory; the first answer afterwards takes a few seconds longer while they load." Header="Voice models">
        <ComboBox MinWidth="280" ItemsSource="{x:Bind ViewModel.UnloadChoices}" SelectedItem="{x:Bind ViewModel.Unload, Mode=TwoWay}" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="What leaves your PC" />
      <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
        <Run Text="• Your voice never leaves the PC: speech is turned into text here (Whisper), and Jarvis's voice is made here (Kokoro)." /><LineBreak />
        <Run Text="• The microphone is on only while you hold the talk or dictate keys, or after you click the cursor (2 minutes at most)." /><LineBreak />
        <Run Text="• Your question (as text) and, if allowed above, the screenshot go to Claude through your own Claude Code login." /><LineBreak />
        <Run Text="• Background jobs send their brief to Claude and use the web and the connectors you added. They can't see your screen." /><LineBreak />
        <Run Text="• Jarvis's own windows (cursor, notch) are hidden from its screenshots and from screen recordings." /><LineBreak />
        <Run Text="• Jarvis only clicks or types for you if the switch above is on, and then only each step you approve." />
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis.App.Settings.Pages.ProactivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Jarvis.App.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" HorizontalAlignment="Left" Spacing="6">
      <TextBlock Style="{StaticResource PageTitle}" Text="Proactive" />
      <settings:SettingRow Description="Jarvis speaks up on its own only when the notch is at rest, never over a fullscreen app, and not while paused. Off: it only shows in the notch." Header="Read it aloud">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Speak, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Mornings and meetings" />
      <settings:SettingRow Description="The first time you're at your PC each morning (until noon), Jarvis says good morning and, with a calendar, what your day holds." Header="Morning brief">
        <ToggleSwitch IsOn="{x:Bind ViewModel.MorningBrief, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="No brief before this time." Header="Morning starts at">
        <TimePicker ClockIdentifier="24HourClock" IsEnabled="{x:Bind ViewModel.MorningBrief, Mode=OneWay}" MinuteIncrement="15" Time="{x:Bind ViewModel.MorningFrom, Mode=TwoWay}" />
      </settings:SettingRow>
      <settings:SettingRow Description="Paste your calendar's private iCal address. Google Calendar: Settings → your calendar → Secret address in iCal format. Outlook: Settings → Calendar → Shared calendars → Publish. Jarvis reads it every 15 minutes, on this PC only." Header="Calendar address">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="300" PlaceholderText="https://…/basic.ics" Text="{x:Bind ViewModel.CalendarAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <Button Command="{x:Bind ViewModel.CheckCalendarCommand}" Content="Check" />
        </StackPanel>
      </settings:SettingRow>
      <TextBlock Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.CalendarStatus, Mode=OneWay}" TextWrapping="Wrap" />
      <settings:SettingRow Description="A heads-up in the notch before each meeting, with a Join button when the invite has a Meet, Zoom or Teams link." Header="Meeting heads-up">
        <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.HeadsUpChoices}" SelectedIndex="{x:Bind ViewModel.HeadsUpIndex, Mode=TwoWay}" />
      </settings:SettingRow>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Suggestions" />
      <settings:SettingRow Description="Jarvis notes the names of the apps and windows you have in front (never screenshots, never private browser windows) and, now and then, sends that list to Claude to see if a background job would help: &quot;Want me to compare those laptops?&quot;. Nothing runs unless you click Do it. Off by default." Header="Suggest things I could hand off">
        <ToggleSwitch IsOn="{x:Bind ViewModel.Suggestions, Mode=TwoWay}" OffContent="" OnContent="" />
      </settings:SettingRow>
      <settings:SettingRow Description="Each check is one short Claude request on your plan. Every one is listed under Privacy &amp; memory." Header="At most">
        <ComboBox MinWidth="180" IsEnabled="{x:Bind ViewModel.Suggestions, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.CadenceChoices}" SelectedIndex="{x:Bind ViewModel.CadenceIndex, Mode=TwoWay}" />
      </settings:SettingRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>

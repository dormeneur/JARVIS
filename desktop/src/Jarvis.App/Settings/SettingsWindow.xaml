<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jarvis.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jarvis.App.Settings"
    Title="Jarvis Settings">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Padding="{StaticResource TitleBarPadding}">
      <TextBlock
          VerticalAlignment="Center"
          FontFamily="{StaticResource FontSmall}"
          FontSize="11"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="Jarvis" />
    </Grid>

    <NavigationView
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        MenuItemsSource="{x:Bind ViewModel.Sections}"
        PaneDisplayMode="Left"
        SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}">
      <NavigationView.MenuItemTemplate>
        <DataTemplate x:DataType="local:SettingsSection">
          <NavigationViewItem Content="{x:Bind Title}">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="{x:Bind Glyph}" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </DataTemplate>
      </NavigationView.MenuItemTemplate>

      <ContentControl
          x:Name="PageHost"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch" />
    </NavigationView>
  </Grid>
</Window>

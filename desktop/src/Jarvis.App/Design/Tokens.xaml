<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens (DESIGN-FACTS.md §2.5). Reference these, never raw values. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BackgroundColor">#FF191A1F</Color>
  <Color x:Key="Surface1Color">#FF1F2025</Color>
  <Color x:Key="Surface2Color">#FF26272D</Color>
  <Color x:Key="NotchCardColor">#FF1A1A1A</Color>
  <Color x:Key="TextPrimaryColor">#FFECECEF</Color>
  <Color x:Key="TextSecondaryColor">#FF9093A0</Color>
  <Color x:Key="TextTertiaryColor">#FF5C5E6A</Color>
  <Color x:Key="SuccessColor">#FF059669</Color>
  <Color x:Key="DestructiveColor">#FFE5484D</Color>
  <Color x:Key="WarningColor">#FFFFB224</Color>
  <Color x:Key="AccentBlueColor">#FF60A5FA</Color>
  <Color x:Key="BorderStrongColor">#24FFFFFF</Color>
  <Color x:Key="BorderSubtleColor">#14FFFFFF</Color>

  <Color x:Key="CursorBlueColor">#FF3380FF</Color>
  <Color x:Key="CursorRedColor">#FFFF4C4C</Color>
  <Color x:Key="CursorYellowColor">#FFD4A017</Color>
  <Color x:Key="CursorGreenColor">#FF26C281</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <x:Double x:Key="SpaceXxs">2</x:Double>
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">20</x:Double>
  <x:Double x:Key="SpaceXxl">24</x:Double>
  <x:Double x:Key="SpaceXxxl">32</x:Double>

  <Thickness x:Key="PagePadding">32</Thickness>
  <Thickness x:Key="TitleBarPadding">16,0,16,0</Thickness>

  <!-- Segoe UI Variable optical sizes: Small < 12px, Text 12–19px, Display ≥ 20px. -->
  <FontFamily x:Key="FontSmall">Segoe UI Variable Small</FontFamily>
  <FontFamily x:Key="FontText">Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
